name: Build APK

on:
  push:
    branches: [main, master]
    tags: ['v*']
  workflow_dispatch:

permissions:
  contents: write

jobs:
  apk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Pasang dependensi
        run: npm install

      - name: Siapkan folder web dan aset
        run: |
          mkdir -p www assets
          cp index.html www/index.html
          cp icon-*.png splash*.png assets/

      - name: Buat proyek Android
        run: npx cap add android

      - name: Buat ikon dan splash screen
        run: npx capacitor-assets generate --android --assetPath assets

      - name: Sinkronkan web ke Android
        run: npx cap sync android

      - name: Build APK debug
        working-directory: android
        run: ./gradlew assembleDebug --no-daemon

      - name: Ganti nama APK
        run: cp android/app/build/outputs/apk/debug/app-debug.apk EnglishMaster.apk

      - uses: actions/upload-artifact@v4
        with:
          name: EnglishMaster-apk
          path: EnglishMaster.apk

      - name: Rilis di GitHub Releases (hanya saat tag v*)
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: EnglishMaster.apk
